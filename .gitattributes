# Keep line endings consistent across machines.
# KiCad writes LF on every platform; force LF so a Windows checkout
# with core.autocrlf doesn't produce spurious whole-file diffs.
* text=auto eol=lf

# Binary assets — never apply line-ending conversion
*.step  binary
*.stp   binary
*.STEP  binary
*.STP   binary
*.wrl   binary
*.3mf   binary
*.pdf   binary
*.raw   binary
*.db    binary
*.png   binary
*.jpg   binary
