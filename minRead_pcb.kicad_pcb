	(gr_text "LP284550/LP304550"
		(at 71.6 94.6 0)
		(layer "Dwgs.User")
		(uuid "ffeee6a8-39c4-4638-86cb-2f7916d12205")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text_box "A LiPo/Li-Ion 3.7V battery can go here and connect to the J5 connector below in the bottom left. A battery protection circuit is included, so you may use unprotected batteries if you really wanted to.\n\nThe circuit is designed to use battery power when independent and USB-C power when plugged in. Any USB-C cable capable of supplying 5V will charge this device, it should be safe with USBC-PD but it will only ask for 5V.\n\nThe screen will connect via J2, and its LED panel to J3. The LED driver circuit is optional, but useful even with a non-frontlit display in case you want to take advantage of the accessory port in the top right. The driver will supply 15mA and up to 29V to the LED+ pins, completing the circuit through C-/W- depending on software toggle. The 15mA limit can be tuned via R37 (value is 82ohm).\n\nThe ESP32-S3 connects via native USB 2.0, and can enter programming mode by holding BOOT, pressing RST, and letting go of both."
		(start 169.545 89.005)
		(end 205.72 112.925)
		(margins 1.0025 1.0025 1.0025 1.0025)
		(layer "F.SilkS")
		(uuid "aba772c3-3172-4976-9a5a-36ce4810147a")
		(effects
			(font
				(face "Roboto")
				(size 0.75 0.75)
				(thickness 0.15)
				(bold yes)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
		(knockout no)
		(render_cache "A LiPo/Li-Ion 3.7V battery can go here and connect to\nthe J5 connector below in the bottom left. A battery\nprotection circuit is included, so you may use\nunprotected batteries if you really wanted to.\n\nThe circuit is designed to use battery power when\nindependent and USB-C power when plugged in. Any\nUSB-C cable capable of supplying 5V will charge this\ndevice, it should be safe with USBC-PD but it will only ask\nfor 5V.\n\nThe screen will connect via J2, and its LED panel to J3.\nThe LED driver circuit is optional, but useful even with a\nnon-frontlit display in case you want to take advantage\nof the accessory port in the top right. The driver will\nsupply 15mA and up to 29V to the LED+ pins, completing\nthe circuit through C-/W- depending on software toggle.\nThe 15mA limit can be tuned via R37 (value is 82ohm).\n\nThe ESP32-S3 connects via native USB 2.0, and can enter\nprogramming mode by holding BOOT, pressing RST, and\nletting go of both."
			0
