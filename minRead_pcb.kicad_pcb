	(gr_text "LED"
		(at 133.25 134 0)
		(layer "B.SilkS")
		(uuid "a9927e48-e2de-4226-b991-cc2255e31eed")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text_box "Welcome to de-link, the open-source ESP32 reading/devkit platform. \n\nAll components will be on the back of this board, maximizing cost and simplicity for DIY. Please build and repair as you please!\n\nThis board mainly supports the GDEQ426T82 display variant, but it can be repurposed for most other GoodDisplay/Waveshare branded SPI e-paper displays. The buttons can be manually placed elsewhere by connecting to the marked positions of each labeled side-mounted switch. The other side of these normally-open switches is ground, with the exception being the power button which is normally open between GPIO3 and 3v3. \n\nYou may also access the header of LED pins, unused GPIO, UART, and GND/3v3 via 10-pin accessory connected on the top of the other side."
		(start 131.75 89.75)
		(end 172.75 125.25)
		(margins 1.0025 1.0025 1.0025 1.0025)
		(layer "F.SilkS")
		(uuid "2d362b9a-efbd-4666-bbb6-a5d15efd9713")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type dash)
		)
	)
	(gr_text_box "LED+ |  G\nW-   |  C-\n46   |  45\n47   |  15\n3V3  |  16"
		(start 193.5 42.125)
		(end 202.5 54.875)
		(margins 1.0025 1.0025 1.0025 1.0025)
		(angle 180)
		(layer "F.SilkS")
		(uuid "e42efeab-9b6a-4337-93a7-72a6b442ce7c")
		(effects
			(font
				(size 1.5 0.7)
				(thickness 0.125)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
	)
	(gr_text_box "3V3 |  16\n17  |  15\n46  |  45\nW-  |  C-\nLED+|  GND"
		(start 264.6505 27.1505)
		(end 273.6505 39.9005)
		(margins 1.0025 1.0025 1.0025 1.0025)
		(layer "B.SilkS")
		(uuid "6f2f4255-340a-44b1-894d-5fb4cc21a1f5")
		(effects
			(font
				(size 1.5 0.7)
				(thickness 0.125)
			)
			(justify left top mirror)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
	)
	(gr_text_box "A LiPo/Li-Ion 3.7V battery can go here and connect to the J5 connector below in the bottom left. A battery protection circuit is included, so you may use unprotected batteries if you really wanted to.\n\nThe circuit is designed to use battery power when independent and USB-C power when plugged in. Any USB-C cable capable of supplying 5V will charge this device, it should be safe with USBC-PD but it will only ask for 5V.\n\nThe screen will connect via J2, and its LED panel to J3. The LED driver circuit is optional, but useful even with a non-frontlit display in case you want to take advantage of the accessory port in the top right. The driver will supply 15mA and up to 29V to the LED+ pins, completing the circuit through C-/W- depending on software toggle. The 15mA limit can be tuned via R37 (value is 82ohm).\n\nThe ESP32-S3 connects via native USB 2.0, and can enter programming mode by holding BOOT, pressing RST, and letting go of both."
		(start 22.5 156)
		(end 55.5 185)
		(margins 1.0025 1.0025 1.0025 1.0025)
		(layer "B.SilkS")
		(uuid "aba772c3-3172-4976-9a5a-36ce4810147a")
		(effects
			(font
				(size 0.75 0.75)
				(thickness 0.1)
			)
			(justify left top mirror)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
	)
